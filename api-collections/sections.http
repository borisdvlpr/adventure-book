# Objective 3. Reading is stateless: no health, no consequences, no session.
# An invalid book is still readable -- walking a broken graph is how you find out why
# it is broken.

### setup: find The Crystal Caverns
GET {{host}}/api/v1/books?title=crystal
Accept: application/json

> {%
    client.global.set("crystalId", response.body.content[0].id);
%}

### setup: find Pirates of the Jade Sea
# Invalid: section 1 points at section 999, which does not exist.
GET {{host}}/api/v1/books?title=pirates
Accept: application/json

> {%
    client.global.set("piratesId", response.body.content[0].id);
%}

### read the entry point
# Objective 2's beginSectionNumber tells a client where to start.
GET {{host}}/api/v1/books/{{crystalId}}/sections/1
Accept: application/json

### follow an option
# Section 1 option 0 has gotoSection 100; option 1 has gotoSection 20.
GET {{host}}/api/v1/books/{{crystalId}}/sections/100
Accept: application/json

### a section whose options carry consequences
# Section 20 option 0 costs 4 health. The reader does NOT show that: publishing the cost
# next to the choice would remove the decision. A player sees it in lastConsequence
# after committing to the move.
GET {{host}}/api/v1/books/{{crystalId}}/sections/20
Accept: application/json

### an ending
# type END, options empty -- which is what makes it an ending.
GET {{host}}/api/v1/books/{{crystalId}}/sections/800
Accept: application/json

### read an invalid book
# Allowed. Section 1 option 1 has gotoSection 999, which is why this book is invalid.
GET {{host}}/api/v1/books/{{piratesId}}/sections/1
Accept: application/json

### follow the dangling option
# 404, type .../section-not-found. An honest answer, not a 500.
GET {{host}}/api/v1/books/{{piratesId}}/sections/999
Accept: application/json

### rejected: unknown section in a valid book
# 404, type .../section-not-found
GET {{host}}/api/v1/books/{{crystalId}}/sections/12345
Accept: application/json

### rejected: unknown book
# 404, type .../book-not-found -- a book-level miss, not a section-level one
GET {{host}}/api/v1/books/999999/sections/1
Accept: application/json
